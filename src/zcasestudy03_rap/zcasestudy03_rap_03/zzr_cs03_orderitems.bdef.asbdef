managed implementation in class ZBP_R_CS03_ORDERITEMS unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZZR_CS03_ORDERITEMS alias OrderItems
persistent table ZCS03_ORDERITEMS
extensible
draft table ZCS03_ORDRTEMS_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   Customerid,
   Orderid,
   Orderitem;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedBy,
   LastChangedAt;

  field ( readonly : update )
   Customerid,
   Orderid,
   Orderitem;


  create;
  update;
  delete;

  determination CalculateItemTotal on save {
    create;
    field Quantity, Price;
  }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCS03_ORDERITEMS corresponding extensible
  {
    Customerid = CUSTOMERID;
    Orderid = ORDERID;
    Orderitem = ORDERITEM;
    Itemid = ITEMID;
    Itemdescription = ITEMDESCRIPTION;
    Quantity = QUANTITY;
    Unit = UNIT;
    Price = PRICE;
    ItemTotal = ITEM_TOTAL;
    Currency = CURRENCY;
    Info = INFO;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
  }

}