managed implementation in class ZBP_I_CS03_CUSTORDERS unique;
strict ( 2 );
with draft;
extensible;

define behavior for ZCS03_I_CUSTORDERS alias Zcs03ICustorders
persistent table zcs03_custorders
extensible
draft table zcs03_cstrders_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( mandatory : create )
  Customerid,
  Orderid;

  field ( readonly )
  LocalLastChangedAt,
  LastChangedAt,
  CreatedBy,
  LastChangedBy,
  ChangeRateDate,
  OrderTotalConverted;

  field ( readonly : update )
  Customerid,
  Orderid;

  create;
  update;
  delete;

  determination convert_currency on save { field OrderTotal, Currency, TargetCurrency; } // T120 A.5 Währungsumrechnung
  determination updateCustomerSalesVolume on save { field OrderTotal, OrderTotalConverted; }
  determination setDefaultStatus on modify { create; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  association _Customer;

  mapping for zcs03_custorders corresponding extensible
    {
      Customerid          = CUSTOMERID;
      Orderid             = ORDERID;
      OrderDate           = ORDER_DATE;
      OrderTotal          = ORDER_TOTAL;
      Discount            = DISCOUNT;
      Info                = INFO;
      Status              = STATUS;
      Currency            = CURRENCY;
      TargetCurrency      = TARGET_CURRENCY;
      ChangeRateDate      = CHANGE_RATE_DATE;
      OrderTotalConverted = ORDER_TOTAL_CONVERTED;
      LocalLastChangedAt  = LOCAL_LAST_CHANGED_AT;
      LastChangedAt       = LAST_CHANGED_AT;
      CreatedBy           = CREATED_BY;
      LastChangedBy       = LAST_CHANGED_BY;
    }
}