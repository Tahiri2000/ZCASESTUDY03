@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'Classname'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'Classname'
annotate view ZC_CS03_STATISTIC with
{ 
  @UI.facet: [ {
    label: 'Allgemeine Informationen', 
    id: 'GeneralInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE
  } ]
  @EndUserText.label: 'Classname'
  @UI.identification: [ {
    position: 10 , 
    label: 'Classname'
  } ]
 @UI.lineItem: [
    {
      position: 10 ,
      label: 'Classname'
    },
    {
      type: #FOR_ACTION,
      dataAction: 'SetActiveClass',
      label: 'Aktivieren',
      position: 1,
      invocationGrouping: #CHANGE_SET
    }
  ]
  Classname;
  
   @UI.identification: [ {
    position: 15 ,
    label: 'Interface'
  } ]
  @UI.lineItem: [ {
    position: 15 ,
    label: 'Interface'
  } ]
  Interface;
  
  @UI.identification: [ {
    position: 20 
  } ]
  LocalLastChangedAt;
  
  @UI.identification: [ {
    position: 30 
  } ]
  LastChangedAt;
  
  @UI.identification: [ {
    position: 40 
  } ]
  CreatedBy;
  
  @UI.identification: [ {
    position: 50 
  } ]
  LastChangedBy;
  
  @UI.identification: [ {
    position: 60
  } ]
  @UI.lineItem: [ {
    position: 60
  } ]
  Active;
}