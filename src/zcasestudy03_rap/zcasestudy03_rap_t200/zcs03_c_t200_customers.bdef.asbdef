projection;
strict ( 2 );
use draft;

define behavior for ZCS03_C_T200_CUSTOMERS //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Orders { create; with draft; }
}

define behavior for ZCS03_C_T200_CUSTORDERS //alias <alias_name>
{
  use update;
  use delete;

  use association _Customer { with draft; }
}